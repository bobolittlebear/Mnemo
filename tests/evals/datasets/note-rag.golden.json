[
  {
    "id": "chunk-basic",
    "kind": "chunk",
    "description": "两个 H2 章节：顶层 H1 整节成 parent，不同 section 的段落各成 child",
    "markdown": "# 部署指南\n\n## 安装\n\n先装 Node 18，再执行 npm install。\n\n## 配置\n\n修改 config.yaml 设置端口。\n\n数据库连接用 MongoDB。",
    "expected": {
      "parentCount": 1,
      "childCount": 2,
      "sectionPaths": [["部署指南"]],
      "childSectionPaths": [["部署指南", "安装"], ["部署指南", "配置"]],
      "forcedSplitCount": 0,
      "contains": ["先装 Node 18", "修改 config.yaml"],
      "notContains": []
    }
  },
  {
    "id": "chunk-multibyte",
    "kind": "chunk",
    "description": "CJK + emoji + 韩文 + 泰语：同 section 短段落合并为单 child，多字节字符不被切断",
    "markdown": "# 多字节测试\n\n这是一段中文内容，包含 emoji 🚀 与韩文 안녕 与泰语 สวัสดี。\n\n第二段纯中文，验证切分不破坏字符。",
    "expected": {
      "parentCount": 1,
      "childCount": 1,
      "sectionPaths": [["多字节测试"]],
      "childSectionPaths": [["多字节测试"]],
      "forcedSplitCount": 0,
      "contains": ["🚀", "안녕", "สวัสดี", "第二段纯中文"],
      "notContains": ["�"]
    }
  },
  {
    "id": "reindex-full-to-diff",
    "kind": "reindex",
    "description": "首次全量（parentsInserted=1, childrenInserted=2）；二次改第二段→父块替换、第一段 reParent（不 re-embed）、第二段 re-embed",
    "initialMarkdown": "# 文档标题\n\n## 第一部分\n\n这是第一段内容，介绍背景。\n\n## 第二部分\n\n这是第二段内容，介绍实现。",
    "updatedMarkdown": "# 文档标题\n\n## 第一部分\n\n这是第一段内容，介绍背景。\n\n## 第二部分\n\n这是第二段内容，已经过修改加入更多细节实现方案。",
    "expectedFirst": {
      "parentsInserted": 1,
      "parentsDeleted": 0,
      "childrenInserted": 2,
      "childrenDeleted": 0,
      "childrenReParented": 0,
      "unchanged": 0,
      "embeddingTokensGt": true
    },
    "expectedAfterUpdate": {
      "parentsInserted": 1,
      "parentsDeleted": 1,
      "childrenInserted": 1,
      "childrenDeleted": 1,
      "childrenReParented": 1,
      "unchanged": 0,
      "embeddingTokensGt": true
    }
  },
  {
    "id": "reindex-reparent",
    "kind": "reindex",
    "description": "改章节标题（子块 content 不变）→ 父块替换、子块 reParent（仅更新引用，不 re-embed）→ embeddingTokensGt=false",
    "initialMarkdown": "# 书籍\n\n## 第一章\n\n内容A保持不变。\n\n## 第二章\n\n内容B保持不变。",
    "updatedMarkdown": "# 书籍\n\n## 第一章（修订）\n\n内容A保持不变。\n\n## 第二章\n\n内容B保持不变。",
    "expectedFirst": {
      "parentsInserted": 1,
      "parentsDeleted": 0,
      "childrenInserted": 2,
      "childrenDeleted": 0,
      "childrenReParented": 0,
      "unchanged": 0,
      "embeddingTokensGt": true
    },
    "expectedAfterUpdate": {
      "parentsInserted": 1,
      "parentsDeleted": 1,
      "childrenInserted": 0,
      "childrenDeleted": 0,
      "childrenReParented": 2,
      "unchanged": 0,
      "embeddingTokensGt": false
    }
  },
  {
    "id": "reindex-delete",
    "kind": "reindex",
    "description": "删除一个章节 → 父块替换、保留段 reParent、删除段 childrenDeleted=1、不 re-embed",
    "initialMarkdown": "# 文档\n\n## 章节甲\n\n甲内容。\n\n## 章节乙\n\n乙内容。",
    "updatedMarkdown": "# 文档\n\n## 章节甲\n\n甲内容。",
    "expectedFirst": {
      "parentsInserted": 1,
      "parentsDeleted": 0,
      "childrenInserted": 2,
      "childrenDeleted": 0,
      "childrenReParented": 0,
      "unchanged": 0,
      "embeddingTokensGt": true
    },
    "expectedAfterUpdate": {
      "parentsInserted": 1,
      "parentsDeleted": 1,
      "childrenInserted": 0,
      "childrenDeleted": 1,
      "childrenReParented": 1,
      "unchanged": 0,
      "embeddingTokensGt": false
    }
  },
  {
    "id": "reindex-missing",
    "kind": "reindex",
    "description": "笔记不存在（findOne=null）→ skipReason NOTE_NOT_FOUND，不触 DB",
    "noteMissing": true,
    "expectedAfterUpdate": {
      "skipReason": "NOTE_NOT_FOUND"
    }
  },
  {
    "id": "reindex-invalid-id",
    "kind": "reindex",
    "description": "非法 noteId → 前置校验短路，skipReason INVALID_ID",
    "invalidNoteId": true,
    "expectedAfterUpdate": {
      "skipReason": "INVALID_ID"
    }
  },
  {
    "id": "search-notebook-filter",
    "kind": "search",
    "description": "跨笔记本 seed（nb1/nb2 混合）→ 传 notebookId=nb1 只返回该笔记本结果",
    "query": "部署服务",
    "searchParams": { "notebookId": "6a8eadce1a1bd4286ad0baa8", "topK": 10 },
    "seedChunks": [
      {
        "_id": "6a8eadce1a1bd4286ad0baa1",
        "chunkType": "child",
        "noteId": "6a8eadce1a1bd4286ad0baa3",
        "notebookId": "6a8eadce1a1bd4286ad0baa8",
        "title": "部署",
        "sectionPath": ["部署"],
        "chunkIndex": 0,
        "content": "如何部署服务以及启动命令",
        "parentId": "6a8eadce1a1bd4286ad0baa2"
      },
      {
        "_id": "6a8eadce1a1bd4286ad0baa2",
        "chunkType": "parent",
        "noteId": "6a8eadce1a1bd4286ad0baa3",
        "notebookId": "6a8eadce1a1bd4286ad0baa8",
        "title": "部署",
        "sectionPath": ["部署"],
        "chunkIndex": 0,
        "content": "# 部署\n\n如何部署服务以及启动命令与配置说明"
      },
      {
        "_id": "6a8eadce1a1bd4286ad0baa4",
        "chunkType": "child",
        "noteId": "6a8eadce1a1bd4286ad0baa5",
        "notebookId": "6a8eadce1a1bd4286ad0baa9",
        "title": "其他",
        "sectionPath": ["其他"],
        "chunkIndex": 0,
        "content": "无关的笔记内容",
        "parentId": "6a8eadce1a1bd4286ad0baa6"
      },
      {
        "_id": "6a8eadce1a1bd4286ad0baa6",
        "chunkType": "parent",
        "noteId": "6a8eadce1a1bd4286ad0baa5",
        "notebookId": "6a8eadce1a1bd4286ad0baa9",
        "title": "其他",
        "sectionPath": ["其他"],
        "chunkIndex": 0,
        "content": "# 其他\n\n无关的笔记内容"
      }
    ],
    "expected": {
      "resultsCount": 1,
      "allMatchNotebookId": true,
      "topHasParentContext": true,
      "parentContextContains": "如何部署服务"
    }
  },
