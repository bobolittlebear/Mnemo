{
    "schemaVersion": "1.0",
    "meta": {
        "purpose": "笔记 RAG 召回评测 query + ground truth 数据集（已基于真实 dump 标注）。每条 query 记录自然语言提问、应召回的 NoteChunk._id 列表与类型，供评测 runner（scripts/run-note-recall-eval.ts）对 searchNotes 三模式（向量路 / BM25 路 / hybrid RRF）计算 recall@K。",
        "sourceDump": "tests/evals/datasets/note-chunks-dump.json（userId=6a0d5c4c78c7d40ee8525db0，1255 chunks / 53 notes / 16 notebooks）",
        "annotationMethod": "逐条在 dump 的 child chunk 中按关键词 + 内容语义核对，挑选确实包含答案原文的块作为 ground truth；cross-notebook 的 notebookId 取自候选块真实 notebookId。",
        "proportion": {
            "negative": "约 10%（5/50）：语料中确实无答案可召回，targetChunkIds 必须为 []",
            "synthetic": "≤20%（8/50）：含 code-token(5) / synthetic-edge(3) 两类",
            "hand": "其余为手标真实信息需求（37/50）：paraphrase(17) / exact(15) / cross-notebook(5）"
        },
        "queryFields": {
            "id": "唯一字符串",
            "query": "自然语言问句，非空串",
            "targetChunkIds": "应召回的 NoteChunk._id 数组，元素为合法 24 位 hex；negative 类型必须为 []",
            "type": "枚举 paraphrase | exact | cross-notebook | code-token | synthetic-edge | negative",
            "notebookId": "可选串，仅 cross-notebook 类型使用，验证笔记本过滤正确性（须为该块真实 notebookId）"
        },
        "typeEnums": [
            "paraphrase - 语义泛化（同义改写），禁止拿原文当 query",
            "exact - 精确术语命中基线",
            "cross-notebook - 跨笔记本关联，验证 notebookId 过滤正确性",
            "code-token - 代码块 token 检索",
            "synthetic-edge - 父子块回填 / 切分边界",
            "negative - 拒绝能力，应返回空"
        ],
        "annotationNote": "本数据集 targetChunkIds 已于 2026-10-12 基于真实 dump 逐条标注，全部为合法真实 NoteChunk._id，无占位符。评测前建议仍跑一次 GT chunk 缺失率检测（runner 内置 >20% 中止），以防 dump 与线上语料漂移。",
        "privacy": "不提交任何 note 正文 / searchText，仅提交 chunkId / notebookId / query 文本 / ground truth。",
        "remapNote": "targetChunkIds 由 note-recall-queries.json 机械重映射：对 dump 中旧 chunkId，按 (noteId, content) 唯一匹配当前 DB child chunk 的新 _id（内容逐字未变，仅 contentHash 变更导致 id 漂移）。仅供本次 M1 评测临时使用。"
    },
